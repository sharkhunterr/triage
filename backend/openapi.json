{
  "components": {
    "schemas": {
      "Credentials": {
        "properties": {
          "password": {
            "maxLength": 200,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 3,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LocaleBody": {
        "properties": {
          "locale": {
            "enum": [
              "en",
              "fr"
            ],
            "title": "Locale",
            "type": "string"
          }
        },
        "required": [
          "locale"
        ],
        "title": "LocaleBody",
        "type": "object"
      },
      "Me": {
        "properties": {
          "locale": {
            "title": "Locale",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "locale"
        ],
        "title": "Me",
        "type": "object"
      },
      "SetupBody": {
        "properties": {
          "locale": {
            "default": "en",
            "enum": [
              "en",
              "fr"
            ],
            "title": "Locale",
            "type": "string"
          },
          "password": {
            "maxLength": 200,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 3,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "SetupBody",
        "type": "object"
      },
      "SetupStatus": {
        "properties": {
          "needs_setup": {
            "title": "Needs Setup",
            "type": "boolean"
          }
        },
        "required": [
          "needs_setup"
        ],
        "title": "SetupStatus",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Triage",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
